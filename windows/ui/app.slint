import { AboutSlint, Button, LineEdit, TextEdit, ComboBox, CheckBox, Switch, ScrollView, ListView, Palette, Spinner, SpinBox } from "std-widgets.slint";

export enum Page { setup, lock, main }
export enum Section { codes, passwords }
export enum Dialog { none, add-code, edit-code, edit-login, export, qr, restore, settings, generator, browser, pair, confirm-access, pin, about }

export struct CodeRow {
    id: int,
    initial: string,
    title: string,
    account: string,
    code: string,
    remaining: int,
    progress: float,
    hotp: bool,
    warn: bool,
    info: string,
    used-by: string,
}

export struct LoginRow {
    id: int,
    initial: string,
    title: string,
    username: string,
    site: string,
    url: string,
    notes: string,
    modified: string,
    otp-title: string,
    otp-code: string,
    otp-remaining: int,
    otp-warn: bool,
}

export struct PickRow {
    id: int,
    title: string,
    subtitle: string,
    checked: bool,
}

export struct BrowserRow {
    id: string,
    name: string,
    detail: string,
}

// Material Design icons (Apache License 2.0).
