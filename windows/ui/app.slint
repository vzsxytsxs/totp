    }
    ContextMenuArea {
        Menu {
            MenuItem { title: "Copy username"; activated => { App.copy-username(root.entry.id); } }
            MenuItem { title: "Copy password"; activated => { App.copy-password(root.entry.id); } }
            if root.entry.otp-code != "": MenuItem { title: "Copy 2FA code"; activated => { App.copy-login-code(root.entry.id); } }
            if root.entry.url != "": MenuItem { title: "Open website"; activated => { App.open-url(root.entry.id); } }
            MenuSeparator { }
            MenuItem { title: "Edit…"; activated => { App.edit-login(root.entry.id); } }
            MenuItem { title: "Delete…"; activated => { App.ask-delete-login(root.entry.id); } }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout { alignment: center; Avatar { letter: root.entry.initial; size: 24px; } }
        Text {
            text: root.entry.title;
            font-weight: 600;
            color: Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 3;
            min-width: 60px;
            preferred-width: 100px;
        }
        Text {
            text: root.entry.username;
            color: Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 3;
            min-width: 60px;
            preferred-width: 100px;
        }
        Text {
            text: root.entry.site;
            color: Theme.dim;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 3;
            min-width: 60px;
            preferred-width: 100px;
        }
        Rectangle {
            width: 36px;
            if root.entry.otp-title != "": Icon { icon: Icons.timer; size: 16px; fill: Theme.brand; }
        }
        Text {
            width: 90px;
            text: root.entry.modified;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
    HSeparator { y: parent.height - 1px; x: 12px; width: parent.width - 24px; background: Theme.faint; }
}

component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> text;
    alignment: center;
    padding: 32px;
    spacing: 10px;
    Text {
        text: root.title;
        font-size: 17px;
        font-weight: 600;
        horizontal-alignment: center;
        color: Palette.foreground;
    }
    Hint { text: root.text; horizontal-alignment: center; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        @children
    }
}

component CodeTable inherits VerticalLayout {
    callback focus-list;
    Rectangle {
        height: 28px;
        background: Theme.panel;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 12px;
            Rectangle { width: 26px; }
            HeaderCell { text: "SERVICE"; horizontal-stretch: 3; min-width: 60px; preferred-width: 100px; }
            HeaderCell { text: "ACCOUNT"; horizontal-stretch: 3; min-width: 60px; preferred-width: 100px; }
            HeaderCell { text: "CODE"; width: 120px; horizontal-alignment: right; }
            HeaderCell { text: "TIME"; width: 56px; horizontal-alignment: right; }
        }
        HSeparator { y: parent.height - 1px; }
    }
    if App.code-total == 0: EmptyState {
        vertical-stretch: 1;
        title: "No 2FA codes yet";
        text: "Add one from a QR code screenshot (Win+Shift+S, then Ctrl+V here), a setup key, or import everything from Google Authenticator.";
        Button {
            text: "Add 2FA code";
            primary: true;
            clicked => { App.dialog-error = ""; App.dialog-info = ""; App.dialog = Dialog.add-code; }
        }
        Button { text: "Restore backup…"; clicked => { App.restore-backup(); } }
    }
    if App.code-total > 0 && App.codes.length == 0: EmptyState {
        vertical-stretch: 1;
        title: "Nothing found";
        text: "No 2FA code matches \"" + App.search + "\".";
    }
    if App.codes.length > 0: ListView {
        vertical-stretch: 1;
        for row[i] in App.codes: CodeItem {
            entry: row;
            selected: i == App.code-index;
            select => { App.code-index = i; App.selection-changed(); root.focus-list(); }
            activate => { App.code-index = i; App.copy-code(row.id); root.focus-list(); }
        }
    }
}

component LoginTable inherits VerticalLayout {
    callback focus-list;
    Rectangle {
        height: 28px;
        background: Theme.panel;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 12px;
            Rectangle { width: 24px; }
            HeaderCell { text: "TITLE"; horizontal-stretch: 3; min-width: 60px; preferred-width: 100px; }
            HeaderCell { text: "USERNAME"; horizontal-stretch: 3; min-width: 60px; preferred-width: 100px; }
            HeaderCell { text: "WEBSITE"; horizontal-stretch: 3; min-width: 60px; preferred-width: 100px; }
            HeaderCell { text: "2FA"; width: 36px; }
            HeaderCell { text: "MODIFIED"; width: 90px; horizontal-alignment: right; }
        }
        HSeparator { y: parent.height - 1px; }
    }
    if App.login-total == 0: EmptyState {
        vertical-stretch: 1;
        title: "No passwords yet";
        text: "Save the logins of your websites here. With the browser extension, Authenticator can fill them in for you while it is unlocked.";
        Button { text: "Add password"; primary: true; clicked => { App.new-login(); } }
        Button { text: "Import from browser (CSV)…"; clicked => { App.import-csv(); } }
    }
    if App.login-total > 0 && App.logins.length == 0: EmptyState {
        vertical-stretch: 1;
        title: "Nothing found";
        text: "No password matches \"" + App.search + "\".";
    }
    if App.logins.length > 0: ListView {
        vertical-stretch: 1;
        for row[i] in App.logins: LoginItem {
            entry: row;
            selected: i == App.login-index;
            select => { App.login-index = i; App.selection-changed(); root.focus-list(); }
            activate => { App.login-index = i; App.copy-password(row.id); root.focus-list(); }
        }
    }
}

component DetailLine inherits HorizontalLayout {
    in property <string> label;
    spacing: 10px;
    height: 28px;
    FieldLabel { text: root.label; width: 80px; }
    @children
}

component CodeDetails inherits Rectangle {
    in property <CodeRow> entry;
    VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout { alignment: center; Avatar { letter: root.entry.initial; size: 40px; } }
            VerticalLayout {
                alignment: center;
                Text { text: root.entry.title; font-size: 16px; font-weight: 600; color: Palette.foreground; overflow: elide; }
                Text { text: root.entry.account; color: Theme.dim; overflow: elide; visible: root.entry.account != ""; }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.entry.code;
                    font-size: 32px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    color: root.entry.warn ? Theme.danger : Theme.code;
                    horizontal-alignment: right;
                }
            }
            if !root.entry.hotp: Countdown {
                width: 70px;
                remaining: root.entry.remaining;
                progress: root.entry.progress;
                warn: root.entry.warn;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Copy code"; primary: true; clicked => { App.copy-code(root.entry.id); } }
            if root.entry.hotp: Button { text: "Next code"; clicked => { App.next-hotp(root.entry.id); } }
            Button { text: "Show QR code…"; clicked => { App.show-code-qr(root.entry.id); } }
            Button { text: "Edit…"; clicked => { App.edit-code(root.entry.id); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Hint { text: root.entry.info; }
        if root.entry.used-by != "": Hint { text: "Used by the saved login " + root.entry.used-by + "."; }
        Rectangle { vertical-stretch: 1; }
    }
}

component LoginDetails inherits Rectangle {
    in property <LoginRow> entry;
    property <bool> shown: App.revealed-id == entry.id;
    VerticalLayout {
        padding: 12px;
        padding-left: 18px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 12px;
            height: 34px;
            VerticalLayout { alignment: center; Avatar { letter: root.entry.initial; size: 28px; } }
            Text { text: root.entry.title; font-size: 16px; font-weight: 600; color: Palette.foreground; vertical-alignment: center; overflow: elide; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Edit…"; clicked => { App.edit-login(root.entry.id); } }
        }
        DetailLine {
            label: "Username";
            Text { text: root.entry.username == "" ? "—" : root.entry.username; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Palette.foreground; }
            IconButton { icon: Icons.copy; label: "Copy username"; enabled: root.entry.username != ""; clicked => { App.copy-username(root.entry.id); } }
        }
        DetailLine {
            label: "Password";
            Text {
                text: root.shown ? App.revealed-password : "••••••••••••";
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                color: Palette.foreground;
                font-family: root.shown ? "Consolas" : "";
            }
            IconButton {
                icon: root.shown ? Icons.eye-off : Icons.eye;
                label: root.shown ? "Hide password" : "Show password";
                clicked => { if (root.shown) { App.revealed-id = -1; } else { App.reveal-password(root.entry.id); } }
            }
            IconButton { icon: Icons.copy; label: "Copy password"; clicked => { App.copy-password(root.entry.id); } }
        }
        DetailLine {
            label: "Website";
            Text { text: root.entry.url == "" ? "—" : root.entry.url; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Palette.foreground; }
            IconButton { icon: Icons.open; label: "Open website"; enabled: root.entry.url != ""; clicked => { App.open-url(root.entry.id); } }
        }
        DetailLine {
            label: "2FA code";
            Text {
                text: root.entry.otp-code == "" ? "—" : root.entry.otp-code + "   (" + root.entry.otp-remaining + " s, " + root.entry.otp-title + ")";
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                color: root.entry.otp-code == "" ? Palette.foreground : root.entry.otp-warn ? Theme.danger : Theme.code;
                font-weight: root.entry.otp-code == "" ? 400 : 600;
            }
            IconButton { icon: Icons.copy; label: "Copy 2FA code"; enabled: root.entry.otp-code != ""; clicked => { App.copy-login-code(root.entry.id); } }
        }
        if root.entry.notes != "": HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Notes"; width: 80px; vertical-alignment: top; }
            Text { text: root.entry.notes; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; font-size: 12px; }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

component StatusBar inherits Rectangle {
    height: 24px;
    background: Theme.panel;
    HSeparator { y: 0; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Text {
            text: App.section == Section.codes
                ? (App.codes.length != App.code-total ? App.codes.length + " of " : "") + (App.code-total == 1 ? "1 code" : App.code-total + " codes")
                : (App.logins.length != App.login-total ? App.logins.length + " of " : "") + (App.login-total == 1 ? "1 password" : App.login-total + " passwords");
            font-size: 11px;
            color: Theme.dim;
            vertical-alignment: center;
        }
        Text {
            // Only problems with the browser integration (details in its dialog).
            text: App.browser-status-error ? "Browser integration: " + App.browser-status : "";
            font-size: 11px;
            color: Theme.danger;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: App.status-right;
            font-size: 11px;
            color: Theme.dim;
            vertical-alignment: center;
        }
    }
}

component MainPage inherits Rectangle {
    property <bool> codes: App.section == Section.codes;
    property <bool> has-selection: codes ? (App.code-index >= 0 && App.code-index < App.codes.length) : (App.login-index >= 0 && App.login-index < App.logins.length);
    public function focus-search() { toolbar.focus-search(); }
    public function focus-list() { keys.focus(); }

    function move(delta: int) {
        if (root.codes) {
            if (App.codes.length == 0) { return; }
            App.code-index = max(0, min(App.codes.length - 1, App.code-index + delta));
        } else {
            if (App.logins.length == 0) { return; }
            App.login-index = max(0, min(App.logins.length - 1, App.login-index + delta));
        }
        App.selection-changed();
    }

    VerticalLayout {
        toolbar := Toolbar {
            has-selection: root.has-selection;
            search-accepted => {
                if (!root.has-selection) { root.move(-100000); }
                keys.focus();
            }
        }
        HSeparator { }
        HorizontalLayout {
            vertical-stretch: 1;
            Sidebar { }
            VSeparator { }
            keys := FocusScope {
                horizontal-stretch: 1;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) { root.move(-1); return accept; }
                    if (event.text == Key.DownArrow) { root.move(1); return accept; }
                    if (event.text == Key.PageUp) { root.move(-10); return accept; }
                    if (event.text == Key.PageDown) { root.move(10); return accept; }
                    if (event.text == Key.Home) { root.move(-100000); return accept; }
                    if (event.text == Key.End) { root.move(100000); return accept; }
                    if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                        if (root.codes) { App.paste-image(); return accept; }
                    }
                    if (!root.has-selection) { return reject; }
                    if (event.text == Key.Return) {
                        if (root.codes) { App.copy-code(App.codes[App.code-index].id); } else { App.copy-password(App.logins[App.login-index].id); }
                        return accept;
                    }
                    if (event.text == Key.Delete) {
                        if (root.codes) { App.ask-delete-code(App.codes[App.code-index].id); } else { App.ask-delete-login(App.logins[App.login-index].id); }
                        return accept;
                    }
                    if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                        if (root.codes) { App.copy-code(App.codes[App.code-index].id); } else { App.copy-password(App.logins[App.login-index].id); }
                        return accept;
                    }
                    if (event.modifiers.control && (event.text == "e" || event.text == "E")) {
                        if (root.codes) { App.edit-code(App.codes[App.code-index].id); } else { App.edit-login(App.logins[App.login-index].id); }
                        return accept;
                    }
                    if (!root.codes && event.modifiers.control && (event.text == "b" || event.text == "B")) {
                        App.copy-username(App.logins[App.login-index].id);
                        return accept;
                    }
                    if (!root.codes && event.modifiers.control && (event.text == "t" || event.text == "T")) {
                        App.copy-login-code(App.logins[App.login-index].id);
                        return accept;
                    }
                    if (!root.codes && event.modifiers.control && (event.text == "u" || event.text == "U")) {
                        App.open-url(App.logins[App.login-index].id);
                        return accept;
                    }
                    reject
                }
                VerticalLayout {
                    if root.codes: CodeTable {
                        vertical-stretch: 1;
                        focus-list => { keys.focus(); }
                    }
                    if !root.codes: LoginTable {
                        vertical-stretch: 1;
                        focus-list => { keys.focus(); }
                    }
                    if root.has-selection: HSeparator { }
                    if root.has-selection && root.codes: CodeDetails {
                        height: 150px;
                        entry: App.codes[App.code-index];
                    }
                    if root.has-selection && !root.codes: LoginDetails {
                        height: 196px;
                        entry: App.logins[App.login-index];
                    }
                }
            }
        }
        StatusBar { }
    }
}

// ------------------------------------------------------------------ dialogs

component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> dialog-width: 460px;
    in property <length> dialog-height: 10000px;
    in property <bool> closable: true;
    // False when a field inside takes the keyboard focus itself.
    in property <bool> focus-frame: true;
    background: #00000066;
    TouchArea { }
    FocusScope {
        init => { if (root.focus-frame) { self.focus(); } }
        key-pressed(event) => {
            if (event.text == Key.Escape && root.closable) {
                App.close-dialog();
                return accept;
            }
            if (App.dialog == Dialog.add-code && event.modifiers.control && (event.text == "v" || event.text == "V")) {
                App.paste-image();
                return accept;
            }
            reject
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.width - 32px, root.dialog-width);
            height: min(frame.preferred-height, root.height - 32px, root.dialog-height);
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            frame := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: root.title; font-size: 16px; font-weight: 600; color: Palette.foreground; horizontal-stretch: 1; vertical-alignment: center; }
                    if root.closable: IconButton {
                        icon: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
                        label: "Close";
                        clicked => { App.close-dialog(); }
                    }
                }
                @children
            }
        }
    }
}

component DialogButtons inherits HorizontalLayout {
    spacing: 8px;
    alignment: end;
}

component Messages inherits VerticalLayout {
    spacing: 4px;
    if App.dialog-error != "": ErrorText { text: App.dialog-error; }
    if App.dialog-info != "": InfoText { text: App.dialog-info; }
}

component AddCodeDialog inherits DialogFrame {
    title: "Add 2FA code";
    dialog-width: 520px;
    property <bool> advanced: false;
    property <int> kind-index: 0;
    property <int> algo-index: 0;
    property <int> digits-index: 0;
    property <string> period-text: "30";
    property <string> counter-text: "0";
    function add() {
        App.add-manual(issuer.text, name.text, secret.text, kind-index, algo-index, digits-index,
            kind-index == 0 ? period-text : counter-text);
    }
    Messages { }
    ScrollView {
        vertical-stretch: 1;
        min-height: 200px;
        preferred-height: content.preferred-height;
        content := VerticalLayout {
            alignment: start;
            padding-right: 14px;
            spacing: 10px;
            SectionTitle { text: "From a QR code"; }
            Hint { text: "Works with a website's setup QR code and with Google Authenticator's \"Transfer accounts\" export codes (add each code in turn)."; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { text: "Paste screenshot (Ctrl+V)"; primary: true; clicked => { App.paste-image(); } }
                Button { text: "Scan screen"; enabled: App.can-scan-screen; clicked => { App.scan-screen(); } }
                Button { text: "Open image…"; clicked => { App.open-image(); } }
            }
            Hint { text: "Tip: press Win+Shift+S, select the QR code, then press Ctrl+V here."; }
            HSeparator { }
            SectionTitle { text: "Setup key"; }
            HorizontalLayout {
                spacing: 8px;
                issuer := LineEdit { placeholder-text: "Service (e.g. GitHub)"; }
                name := LineEdit { placeholder-text: "Account (e.g. you@example.com)"; }
            }
            secret := LineEdit {
                placeholder-text: "Secret key";
                accepted => { root.add(); }
            }
            CheckBox { text: "Advanced options"; checked <=> root.advanced; }
            if root.advanced: HorizontalLayout {
                spacing: 8px;
                ComboBox { model: ["TOTP (time)", "HOTP (counter)"]; current-index <=> root.kind-index; }
                ComboBox { model: ["SHA1", "SHA256", "SHA512"]; current-index <=> root.algo-index; }
                ComboBox { model: ["6 digits", "7 digits", "8 digits"]; current-index <=> root.digits-index; }
                if root.kind-index == 0: LineEdit { text <=> root.period-text; input-type: number; placeholder-text: "Period (s)"; width: 90px; }
                if root.kind-index != 0: LineEdit { text <=> root.counter-text; input-type: number; placeholder-text: "Counter"; width: 90px; }
            }
            HorizontalLayout {
                alignment: start;
                Button { text: "Add"; clicked => { root.add(); } }
            }
            HSeparator { }
            SectionTitle { text: "Link"; }
            HorizontalLayout {
                spacing: 8px;
                link := LineEdit {
                    placeholder-text: "otpauth://… or otpauth-migration://…";
                    accepted => { App.add-link(link.text); }
                }
                Button { text: "Add from link"; clicked => { App.add-link(link.text); } }
            }
            HSeparator { }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Hint { text: "Moving from another device?"; vertical-alignment: center; }
                Button { text: "Restore backup file…"; clicked => { App.restore-backup(); } }
            }
        }
    }
}

component EditCodeDialog inherits DialogFrame {
    title: App.confirm-delete ? "Delete 2FA code?" : "Edit 2FA code";
    if !App.confirm-delete: VerticalLayout {
        spacing: 8px;
        FieldLabel { text: "Service"; }
        LineEdit { text <=> App.edit-issuer; placeholder-text: "Service"; }
        FieldLabel { text: "Account"; }
        LineEdit { text <=> App.edit-name; placeholder-text: "Account"; }
        Hint { text: App.edit-code-info; }
    }
    if App.confirm-delete: ErrorText {
        text: "\"" + App.edit-issuer + "\" will be removed from this PC. Make sure you can still sign in another way (for example, the code is also on your phone), or you may lose access to the account.";
        font-size: 13px;
    }
    HorizontalLayout {
        spacing: 8px;
        if !App.confirm-delete: Button { text: "Delete…"; clicked => { App.confirm-delete = true; } }
        if !App.confirm-delete: Button { text: "Show QR code…"; clicked => { App.show-code-qr(App.edit-code-id); } }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Cancel";
            clicked => { if (App.confirm-delete) { App.confirm-delete = false; } else { App.close-dialog(); } }
        }
        if !App.confirm-delete: Button { text: "Save"; primary: true; clicked => { App.save-code(); } }
        if App.confirm-delete: Button { text: "Delete"; primary: true; clicked => { App.delete-code(App.edit-code-id); } }
    }
}

component GeneratorOptions inherits VerticalLayout {
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        FieldLabel { text: "Length"; width: 50px; }
        SpinBox {
            width: 110px;
            minimum: 4;
            maximum: 128;
            value <=> App.gen-length;
            edited => { App.generator-changed(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 10px;
        CheckBox { text: "a-z"; checked <=> App.gen-lower; toggled => { App.generator-changed(); } }
        CheckBox { text: "A-Z"; checked <=> App.gen-upper; toggled => { App.generator-changed(); } }
        CheckBox { text: "0-9"; checked <=> App.gen-digits; toggled => { App.generator-changed(); } }
        CheckBox { text: "!@#"; checked <=> App.gen-symbols; toggled => { App.generator-changed(); } }
    }
    CheckBox { text: "Avoid look-alike characters (Il1O0)"; checked <=> App.gen-similar; toggled => { App.generator-changed(); } }
}

component EditLoginDialog inherits DialogFrame {
    title: App.confirm-delete ? "Delete password?" : App.login-edit-id < 0 ? "Add password" : "Edit password";
    dialog-width: 560px;
    focus-frame: false;
    property <bool> show-password: false;
    property <bool> show-generator: false;
    Messages { }
    if App.confirm-delete: ErrorText {
        text: "\"" + (App.login-title != "" ? App.login-title : App.login-url) + "\" will be deleted. If it is not saved anywhere else, you will need the website's \"forgot password\" option to get back in.";
        font-size: 13px;
    }
    if !App.confirm-delete: ScrollView {
        vertical-stretch: 1;
        min-height: 160px;
        preferred-height: form.preferred-height;
        form := VerticalLayout {
            alignment: start;
            padding-right: 14px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                FieldLabel { text: "Title"; width: 80px; }
                title-edit := LineEdit {
                    text <=> App.login-title;
                    placeholder-text: "Name shown in the list (optional)";
                    init => { self.focus(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                FieldLabel { text: "Website"; width: 80px; }
                LineEdit { text <=> App.login-url; placeholder-text: "https://example.com"; }
            }
            HorizontalLayout {
                spacing: 10px;
                FieldLabel { text: "Username"; width: 80px; }
                LineEdit { text <=> App.login-username; placeholder-text: "Username or email"; }
            }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Password"; width: 84px; }
                LineEdit {
                    text <=> App.login-password;
                    input-type: root.show-password ? InputType.text : InputType.password;
                    placeholder-text: "Password";
                }
                IconButton {
                    icon: root.show-password ? Icons.eye-off : Icons.eye;
                    label: root.show-password ? "Hide password" : "Show password";
                    clicked => { root.show-password = !root.show-password; }
                }
                IconButton {
                    icon: Icons.dice;
                    label: "Generate a password";
                    clicked => { App.fill-generated(); root.show-password = true; }
                }
            }
            HorizontalLayout {
                padding-left: 90px;
                LinkText {
                    text: root.show-generator ? "Hide generator options" : "Generator options";
                    clicked => { root.show-generator = !root.show-generator; }
                }
            }
            if root.show-generator: HorizontalLayout {
                padding-left: 90px;
                GeneratorOptions { }
            }
            HorizontalLayout {
                spacing: 10px;
                FieldLabel { text: "2FA code"; width: 80px; }
                ComboBox {
                    model: App.otp-choices;
                    current-index <=> App.login-otp-index;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                FieldLabel { text: "Notes"; width: 80px; vertical-alignment: top; }
                TextEdit {
                    text <=> App.login-notes;
                    height: 72px;
                    wrap: word-wrap;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        if !App.confirm-delete && App.login-edit-id >= 0: Button { text: "Delete…"; clicked => { App.confirm-delete = true; } }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Cancel";
            clicked => { if (App.confirm-delete) { App.confirm-delete = false; } else { App.close-dialog(); } }
        }
        if !App.confirm-delete: Button { text: "Save"; primary: true; clicked => { App.save-login(); } }
        if App.confirm-delete: Button { text: "Delete"; primary: true; clicked => { App.delete-login(App.login-edit-id); } }
    }
}

component GeneratorDialog inherits DialogFrame {
    title: "Password generator";
    Rectangle {
        height: 44px;
        border-radius: 6px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Palette.border;
        Text {
            x: 12px;
            width: parent.width - 24px;
            text: App.gen-result;
            font-size: 16px;
            font-family: "Consolas";
            color: Palette.foreground;
            overflow: elide;
        }
    }
    GeneratorOptions { }
    DialogButtons {
        Button { text: "New password"; clicked => { App.generator-changed(); } }
        Button { text: "Copy"; primary: true; clicked => { App.copy-generated(); } }
    }
}

component PickList inherits Rectangle {
    in property <[PickRow]> rows;
    in property <bool> codes;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 4px;
    ListView {
        for row[i] in root.rows: Rectangle {
            height: 30px;
            TouchArea { clicked => { App.toggle-pick(root.codes, i); } }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                CheckBox {
                    checked: row.checked;
                    toggled => { App.toggle-pick(root.codes, i); }
                }
                Text { text: row.title; vertical-alignment: center; overflow: elide; color: Palette.foreground; horizontal-stretch: 1; preferred-width: 100px; min-width: 40px; }
                Text { text: row.subtitle; vertical-alignment: center; overflow: elide; color: Theme.dim; font-size: 12px; horizontal-stretch: 1; preferred-width: 100px; min-width: 40px; }
            }
        }
    }
}

component ExportDialog inherits DialogFrame {
    title: "Export and transfer";
    dialog-width: 640px;
    function submit() {
        App.export-backup(pw.text, pw2.text);
        pw.text = "";
        pw2.text = "";
    }
    Messages { }
    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 1;
        min-height: 150px;
        preferred-height: 230px;
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                SectionTitle { text: "2FA codes (" + App.export-code-count + "/" + App.export-codes.length + ")"; horizontal-stretch: 1; }
                LinkText { text: "All"; clicked => { App.pick-all(true, true); } }
                Rectangle { width: 8px; }
                LinkText { text: "None"; clicked => { App.pick-all(true, false); } }
            }
            PickList { rows: App.export-codes; codes: true; vertical-stretch: 1; }
        }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                SectionTitle { text: "Passwords (" + App.export-login-count + "/" + App.export-logins.length + ")"; horizontal-stretch: 1; }
                LinkText { text: "All"; clicked => { App.pick-all(false, true); } }
                Rectangle { width: 8px; }
                LinkText { text: "None"; clicked => { App.pick-all(false, false); } }
            }
            PickList { rows: App.export-logins; codes: false; vertical-stretch: 1; }
        }
    }
    HSeparator { }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            SectionTitle { text: "QR codes"; }
            Hint { text: "For Google Authenticator, this app on Android and most authenticators. 2FA codes only. Anyone who sees them can copy your accounts."; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                alignment: start;
                Button { text: "Show QR codes…"; enabled: App.export-code-count > 0; clicked => { App.export-qr(); } }
            }
        }
        VSeparator { }
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            SectionTitle { text: "Encrypted backup file"; }
            Hint { text: "The selected codes and passwords, protected by a password (Argon2id + AES-256). Opens in this app on Android or another PC."; }
            pw := LineEdit { input-type: password; placeholder-text: "Backup password (8+ characters)"; }
            pw2 := LineEdit { input-type: password; placeholder-text: "Repeat password"; accepted => { root.submit(); } }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: "Save backup file…";
                    primary: true;
                    enabled: App.export-code-count + App.export-login-count > 0;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}

component QrDialog inherits DialogFrame {
    title: App.qr-title;
    dialog-width: 480px;
    Hint {
        text: App.qr-account-id >= 0
            ? "Scan it with Google Authenticator, this app on Android or any other authenticator app."
            : "In Google Authenticator: Transfer accounts → Import accounts. In this app on Android: + → Scan QR code.";
        horizontal-alignment: center;
    }
    qr-area := Rectangle {
        min-height: 180px;
        preferred-height: 320px;
        vertical-stretch: 1;
        Rectangle {
            x: (qr-area.width - self.width) / 2;
            y: (qr-area.height - self.height) / 2;
            width: min(qr-area.width, qr-area.height);
            height: self.width;
            background: white;
            border-radius: 6px;
            if App.qr-images.length > 0: Image {
                width: parent.width - 16px;
                height: parent.height - 16px;
                source: App.qr-images[App.qr-index];
                image-rendering: pixelated;
                accessible-role: image;
                accessible-label: "QR code";
            }
        }
    }
    if App.qr-images.length > 1: Text {
        text: "Code " + (App.qr-index + 1) + " of " + App.qr-images.length;
        font-weight: 600;
        horizontal-alignment: center;
        color: Palette.foreground;
    }
    Hint { text: App.qr-note; horizontal-alignment: center; visible: App.qr-note != ""; }
    Text {
        text: "Anyone who sees this code can copy the account. Close it when you are done.";
        font-size: 12px;
        color: Theme.warn;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
    Messages { }
    HorizontalLayout {
        spacing: 8px;
        if App.qr-account-id >= 0: Button { text: "Copy setup key"; clicked => { App.copy-secret(App.qr-account-id); } }
        Rectangle { horizontal-stretch: 1; }
        if App.qr-images.length > 1: Button { text: "Previous"; enabled: App.qr-index > 0; clicked => { App.qr-index -= 1; } }
        if App.qr-index < App.qr-images.length - 1: Button { text: "Next"; primary: true; clicked => { App.qr-index += 1; } }
        if App.qr-index >= App.qr-images.length - 1: Button { text: "Done"; primary: true; clicked => { App.close-dialog(); } }
    }
}

component PinDialog inherits DialogFrame {
    title: "Confirm it's you";
    dialog-width: 400px;
    focus-frame: false;
    function submit() {
        App.pin-entered(pin.text);
        pin.text = "";
    }
    Hint { text: App.pin-reason; }
    pin := LineEdit {
        input-type: password;
        placeholder-text: "PIN or password";
        init => { self.focus(); }
        accepted => { root.submit(); }
    }
    Messages { }
    DialogButtons {
        Button { text: "Cancel"; clicked => { App.close-dialog(); } }
        Button { text: "Continue"; primary: true; clicked => { root.submit(); } }
    }
}

component RestoreDialog inherits DialogFrame {
    title: "Restore backup";
    dialog-width: 400px;
    focus-frame: false;
    function submit() {
        App.restore-password(pw.text);
        pw.text = "";
    }
    Hint { text: "Enter the password used when the backup was created. Codes and passwords are added to the ones already here; nothing is deleted."; }
    pw := LineEdit {
        input-type: password;
        placeholder-text: "Backup password";
        init => { self.focus(); }
        accepted => { root.submit(); }
    }
    Messages { }
    DialogButtons {
        Button { text: "Cancel"; clicked => { App.close-dialog(); } }
        Button { text: "Restore"; primary: true; clicked => { root.submit(); } }
    }
}

component SettingsDialog inherits DialogFrame {
    title: "Settings";
    dialog-width: 560px;
    function submit-pin() {
        App.change-pin(current.text, new-pin.text, confirm.text);
        current.text = "";
        new-pin.text = "";
        confirm.text = "";
    }
    Messages { }
    ScrollView {
        vertical-stretch: 1;
        min-height: 200px;
        preferred-height: content.preferred-height;
        content := VerticalLayout {
            alignment: start;
            padding-right: 14px;
            spacing: 8px;
            SectionTitle { text: "Security"; }
            HorizontalLayout {
                spacing: 10px;
                FieldLabel { text: "Lock automatically"; width: 150px; }
                ComboBox {
                    model: ["After 1 minute without use", "After 5 minutes without use", "After 15 minutes without use", "After 1 hour without use", "Never"];
                    current-index <=> App.auto-lock-index;
                    selected => { App.settings-changed(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                FieldLabel { text: "Clipboard"; width: 150px; }
                ComboBox {
                    model: ["Clear clipboard after 15 seconds", "Clear clipboard after 30 seconds", "Clear clipboard after 60 seconds", "Never clear clipboard"];
                    current-index <=> App.clipboard-index;
                    selected => { App.settings-changed(); }
                }
            }
            Switch {
                text: "Lock when Windows locks or goes to sleep";
                checked <=> App.lock-on-session-lock;
                toggled => { App.settings-changed(); }
            }
            Switch {
                text: "Hide this window from screenshots and screen sharing";
                checked <=> App.hide-from-capture;
                toggled => { App.settings-changed(); }
            }
            HSeparator { }
            SectionTitle { text: "Windows"; }
            Switch {
                text: "Keep running in the notification area when closed";
                checked <=> App.close-to-tray;
                enabled: App.tray-supported;
                toggled => { App.settings-changed(); }
            }
            Switch {
                text: "Start with Windows (locked, in the notification area)";
                checked <=> App.start-with-windows;
                enabled: App.tray-supported;
                toggled => { App.start-with-windows-changed(self.checked); }
            }
            HSeparator { }
            SectionTitle { text: "Browser extension"; }
            Switch {
                text: "Ask me in this window before giving a password to the browser";
                checked <=> App.confirm-browser-access;
                toggled => { App.settings-changed(); }
            }
            HorizontalLayout {
                alignment: start;
                Button { text: "Browser integration…"; clicked => { App.open-browser(); } }
            }
            HSeparator { }
            SectionTitle { text: "Change PIN"; }
            current := LineEdit { input-type: password; placeholder-text: "Current PIN or password"; }
            HorizontalLayout {
                spacing: 8px;
                new-pin := LineEdit { input-type: password; placeholder-text: "New PIN or password"; }
                confirm := LineEdit { input-type: password; placeholder-text: "Repeat new PIN"; accepted => { root.submit-pin(); } }
            }
            HorizontalLayout {
                alignment: start;
                Button { text: "Change PIN"; clicked => { root.submit-pin(); } }
            }
        }
    }
}

component BrowserDialog inherits DialogFrame {
    title: "Browser integration";
    dialog-width: 600px;
    Messages { }
    ScrollView {
        vertical-stretch: 1;
        min-height: 200px;
        preferred-height: content.preferred-height;
        content := VerticalLayout {
            alignment: start;
            padding-right: 14px;
            spacing: 8px;
            Hint {
                text: "The Authenticator extension fills in your saved logins and 2FA codes on websites. It talks only to this app, on this PC, and only while the app is unlocked. Nothing goes over the internet.";
            }
            Switch {
                text: "Allow the browser extension to connect";
                checked <=> App.browser-enabled;
                toggled => { App.browser-toggled(self.checked); }
            }
            if App.browser-status != "": Text {
                text: App.browser-status;
                wrap: word-wrap;
                font-size: 12px;
                color: App.browser-status-error ? Theme.danger : Theme.dim;
            }
            if App.browser-enabled: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "Install the extension (once per browser)"; }
                Hint { text: "Works in Chromium-based browsers: Thorium, Chrome, Edge, Brave, Vivaldi, Opera."; }
                Text { text: "1. Open the extensions page (thorium://extensions, chrome://extensions or edge://extensions)."; wrap: word-wrap; font-size: 12px; color: Palette.foreground; }
                Text { text: "2. Turn on \"Developer mode\"."; wrap: word-wrap; font-size: 12px; color: Palette.foreground; }
                Text { text: "3. Click \"Load unpacked\" and choose this folder:"; wrap: word-wrap; font-size: 12px; color: Palette.foreground; }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        border-radius: 4px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Palette.border;
                        height: 30px;
                        horizontal-stretch: 1;
                        Text { x: 8px; width: parent.width - 16px; text: App.browser-folder; font-size: 12px; overflow: elide; color: Palette.foreground; }
                    }
                    Button { text: "Copy"; clicked => { App.browser-copy-path(); } }
                    Button { text: "Open folder"; clicked => { App.browser-open-folder(); } }
                }
                Text { text: "4. The extension opens its settings: click \"Connect\" there, then \"Allow\" here if both show the same code."; wrap: word-wrap; font-size: 12px; color: Palette.foreground; }
                Hint { text: "Shortcut on a login page: Ctrl+Shift+U fills the login (and the 2FA code on the next page)."; }
                HSeparator { }
                SectionTitle { text: "Connected browsers"; }
                if App.browser-clients.length == 0: Hint { text: "None yet."; }
                for client in App.browser-clients: HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    VerticalLayout { alignment: center; Icon { icon: Icons.extension; size: 16px; fill: Theme.brand; } }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: client.name; color: Palette.foreground; overflow: elide; }
                        Text { text: client.detail; font-size: 11px; color: Theme.dim; overflow: elide; }
                    }
                    Button { text: "Disconnect"; clicked => { App.browser-remove(client.id); } }
                }
            }
        }
    }
}

component PairDialog inherits DialogFrame {
    title: "Connect a browser?";
    dialog-width: 420px;
    closable: false;
    Text {
        text: "\"" + App.pair-name + "\" wants to use your saved logins. Allow it only if you just clicked \"Connect\" in the Authenticator extension and it shows the same code:";
        wrap: word-wrap;
        color: Palette.foreground;
    }
    Text {
        text: App.pair-code;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 3px;
        horizontal-alignment: center;
        color: Theme.brand;
    }
    DialogButtons {
        Button { text: "Deny"; clicked => { App.pair-answer(false); } }
        Button { text: "Allow"; primary: true; clicked => { App.pair-answer(true); } }
    }
}

component AccessDialog inherits DialogFrame {
    title: "Give a password to the browser?";
    dialog-width: 420px;
    closable: false;
    Text { text: App.access-text; wrap: word-wrap; color: Palette.foreground; }
    DialogButtons {
        Button { text: "Deny"; clicked => { App.access-answer(false); } }
        Button { text: "Allow"; primary: true; clicked => { App.access-answer(true); } }
    }
}

component AboutDialog inherits DialogFrame {
    title: "About Authenticator";
    dialog-width: 520px;
    HorizontalLayout {
        spacing: 14px;
        BrandMark { size: 48px; }
        VerticalLayout {
            alignment: center;
            Text { text: "Authenticator " + App.version; font-size: 15px; font-weight: 600; color: Palette.foreground; }
            Hint { text: "2FA codes and passwords, completely offline."; }
        }
    }
    Hint { text: "Data file (encrypted): " + App.data-path; }
    SectionTitle { text: "Keyboard"; }
    Hint {
        text: "Ctrl+N add code · Ctrl+Shift+N add password · Ctrl+F search · Ctrl+1 / Ctrl+2 switch lists\nEnter or double-click: copy code / password · Ctrl+C copy · Ctrl+B copy username · Ctrl+T copy 2FA code of a login · Ctrl+U open website · Ctrl+E edit · Del delete\nCtrl+V paste a QR code screenshot · Ctrl+G password generator · Ctrl+L lock · Ctrl+W hide to the notification area · Ctrl+Q quit";
    }
    AboutSlint { }
}

// ------------------------------------------------------------------ window

export component AppWindow inherits Window {
    title: "Authenticator";
    icon: @image-url("../assets/icon.png");
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 760px;
    min-height: 520px;
    background: Palette.background;
    default-font-size: 13px;

    property <bool> unlocked: App.page == Page.main;
    property <bool> free: unlocked && App.dialog == Dialog.none && !App.busy;

    public function focus-list() { if (main.visible) { main.focus-list(); } }
    public function focus-pin() { if (lock-page.visible) { lock-page.focus-pin(); } }

    function open-add-code() {
        App.section = Section.codes;
        App.section-changed();
        App.dialog-error = "";
        App.dialog-info = "";
        App.dialog = Dialog.add-code;
    }

    MenuBar {
        visible: root.unlocked;
        Menu {
            title: "File";
            MenuItem { title: "Lock"; shortcut: @keys(Control + L); activated => { App.lock(); } }
            MenuSeparator { }
            MenuItem { title: "Export / back up…"; enabled: root.free; activated => { App.open-export(); } }
            MenuItem { title: "Restore backup…"; enabled: root.free; activated => { App.restore-backup(); } }
            MenuItem { title: "Import passwords from browser (CSV)…"; enabled: root.free; activated => { App.import-csv(); } }
            MenuSeparator { }
            MenuItem { title: "Settings…"; enabled: root.free; activated => { App.open-settings(); } }
            MenuSeparator { }
            MenuItem { title: "Hide to notification area"; shortcut: @keys(Control + W); enabled: App.tray-supported; activated => { App.hide-window(); } }
            MenuItem { title: "Quit"; shortcut: @keys(Control + Q); activated => { App.quit(); } }
        }
        Menu {
            title: "Entry";
            MenuItem { title: "Add 2FA code…"; shortcut: @keys(Control + N); enabled: root.free; activated => { root.open-add-code(); } }
            MenuItem {
                title: "Add password…";
                shortcut: @keys(Control + Shift + N);
                enabled: root.free;
                activated => { App.section = Section.passwords; App.section-changed(); App.new-login(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Edit…";
                enabled: root.free && (App.section == Section.codes ? App.code-index >= 0 : App.login-index >= 0);
                activated => {
                    if (App.section == Section.codes) { App.edit-code(App.codes[App.code-index].id); } else { App.edit-login(App.logins[App.login-index].id); }
                }
            }
            MenuItem {
                title: "Delete…";
                enabled: root.free && (App.section == Section.codes ? App.code-index >= 0 : App.login-index >= 0);
                activated => {
                    if (App.section == Section.codes) { App.ask-delete-code(App.codes[App.code-index].id); } else { App.ask-delete-login(App.logins[App.login-index].id); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Show QR code…";
                enabled: root.free && App.section == Section.codes && App.code-index >= 0;
                activated => { App.show-code-qr(App.codes[App.code-index].id); }
            }
            MenuItem {
                title: "Open website";
                enabled: root.free && App.section == Section.passwords && App.login-index >= 0;
                activated => { App.open-url(App.logins[App.login-index].id); }
            }
        }
        Menu {
            title: "View";
            MenuItem { title: "2FA codes"; shortcut: @keys(Control + "1"); activated => { App.section = Section.codes; App.section-changed(); } }
            MenuItem { title: "Passwords"; shortcut: @keys(Control + "2"); activated => { App.section = Section.passwords; App.section-changed(); } }
            MenuSeparator { }
            MenuItem { title: "Search"; shortcut: @keys(Control + F); enabled: root.free; activated => { main.focus-search(); } }
        }
        Menu {
            title: "Tools";
            MenuItem { title: "Password generator…"; shortcut: @keys(Control + G); enabled: root.free; activated => { App.dialog-error = ""; App.generator-changed(); App.dialog = Dialog.generator; } }
            MenuSeparator { }
            MenuItem { title: "Paste QR code screenshot"; enabled: root.free; activated => { App.section = Section.codes; App.section-changed(); App.paste-image(); } }
            MenuItem { title: "Scan screen for a QR code"; enabled: root.free && App.can-scan-screen; activated => { App.section = Section.codes; App.section-changed(); App.scan-screen(); } }
            MenuItem { title: "Open QR code image…"; enabled: root.free; activated => { App.section = Section.codes; App.section-changed(); App.open-image(); } }
            MenuSeparator { }
            MenuItem { title: "Browser integration…"; enabled: root.free; activated => { App.open-browser(); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "About Authenticator"; enabled: root.unlocked; activated => { App.dialog = Dialog.about; } }
        }
    }

    if App.page == Page.setup: SetupPage { }
    lock-page := LockPage {
        visible: App.page == Page.lock;
    }
    main := MainPage {
        visible: App.page == Page.main;
    }

    if App.dialog == Dialog.add-code: AddCodeDialog { }
    if App.dialog == Dialog.edit-code: EditCodeDialog { }
    if App.dialog == Dialog.edit-login: EditLoginDialog { }
    if App.dialog == Dialog.generator: GeneratorDialog { }
    if App.dialog == Dialog.export: ExportDialog { }
    if App.dialog == Dialog.qr: QrDialog { }
    if App.dialog == Dialog.pin: PinDialog { }
    if App.dialog == Dialog.restore: RestoreDialog { }
    if App.dialog == Dialog.settings: SettingsDialog { }
    if App.dialog == Dialog.browser: BrowserDialog { }
    if App.dialog == Dialog.pair: PairDialog { }
    if App.dialog == Dialog.confirm-access: AccessDialog { }
    if App.dialog == Dialog.about: AboutDialog { }

    if App.toast-visible: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 64px;
        width: min(toast-label.preferred-width + 36px, parent.width - 32px);
        height: 36px;
        border-radius: 18px;
        background: App.toast-error ? #8b1a12f0 : #202020f0;
        toast-label := Text {
            text: App.toast-text;
            color: white;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
            width: parent.width - 24px;
        }
    }

    if App.busy: Rectangle {
        background: #00000070;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                Spinner { indeterminate: true; width: 40px; height: 40px; }
            }
            Text {
                text: App.busy-text;
                color: white;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }
    }
}
