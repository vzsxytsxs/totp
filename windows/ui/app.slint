global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Same blue as the Android app.
    out property <color> brand: dark ? #b0c6ff : #2563eb;
    out property <color> brand-soft: dark ? #b0c6ff26 : #2563eb1f;
    out property <color> dim: Palette.foreground.with-alpha(0.62);
    out property <color> faint: Palette.foreground.with-alpha(0.08);
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> warn: dark ? #fce100 : #9d5d00;
    out property <color> code: dark ? #c9d8ff : #0b3fb3;
    out property <color> panel: dark ? #ffffff08 : #00000006;
    out property <color> sidebar: dark ? #ffffff0a : #0000000a;
}

export global App {
    in-out property <Page> page: Page.lock;
    in-out property <Section> section: Section.codes;
    in-out property <Dialog> dialog: Dialog.none;

    in property <[CodeRow]> codes;
    in property <[LoginRow]> logins;
    in property <int> code-total;
    in property <int> login-total;
    in-out property <int> code-index: -1;
    in-out property <int> login-index: -1;
    in-out property <string> search;

    in property <bool> busy;
    in property <string> busy-text;
    in-out property <string> lock-error;
    in property <string> lock-hint;
    in property <string> toast-text;
    in property <bool> toast-visible;
    in property <bool> toast-error;
    in property <string> status-right;
    in property <string> version;
    in property <string> data-path;
    in property <bool> can-scan-screen: true;
    in-out property <string> dialog-error;
    in-out property <string> dialog-info;
    // Edit dialogs open on their "really delete?" step.
    in-out property <bool> confirm-delete;

    // Edit 2FA code
    in-out property <int> edit-code-id: -1;
    in-out property <string> edit-issuer;
    in-out property <string> edit-name;
    in property <string> edit-code-info;

    // Add / edit login
    in-out property <int> login-edit-id: -1;
    in-out property <string> login-title;
    in-out property <string> login-username;
    in-out property <string> login-password;
    in-out property <string> login-url;
    in-out property <string> login-notes;
    in-out property <int> login-otp-index;
    in property <[string]> otp-choices;
    in-out property <int> revealed-id: -1;
    in property <string> revealed-password;

    // Password generator
    in-out property <int> gen-length: 20;
    in-out property <bool> gen-lower: true;
    in-out property <bool> gen-upper: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    in-out property <bool> gen-similar;
    in-out property <string> gen-result;

    // Export
    in property <[PickRow]> export-codes;
    in property <[PickRow]> export-logins;
    in property <int> export-code-count;
    in property <int> export-login-count;

    // QR codes on screen
    in property <string> qr-title;
    in property <[image]> qr-images;
    in-out property <int> qr-index;
    in property <string> qr-note;
    in property <int> qr-account-id: -1;

    // PIN confirmation before showing secrets
    in property <string> pin-reason;

    // Settings
    in-out property <int> auto-lock-index;
    in-out property <int> clipboard-index;
    in-out property <bool> hide-from-capture;
    in-out property <bool> lock-on-session-lock;
    in-out property <bool> close-to-tray;
    in-out property <bool> start-with-windows;
    in-out property <bool> confirm-browser-access;
    in property <bool> tray-supported;

    // Browser integration
    in-out property <bool> browser-enabled;
    in property <string> browser-folder;
    in property <string> browser-status;
    in property <bool> browser-status-error;
    in property <[BrowserRow]> browser-clients;
    in property <string> pair-name;
    in property <string> pair-code;
    in property <string> access-text;

    callback create-pin(string, string);
    callback unlock(string);
    callback reset-all(string);
    callback lock();
    callback quit();
    callback hide-window();
    callback search-changed(string);
    callback section-changed();
    callback selection-changed();

    callback copy-code(int);
    callback next-hotp(int);
    callback edit-code(int);
    callback save-code();
    callback ask-delete-code(int);
    callback delete-code(int);
    callback show-code-qr(int);
    callback copy-secret(int);
    callback paste-image();
    callback scan-screen();
    callback open-image();
    callback add-manual(string, string, string, int, int, int, string);
    callback add-link(string);

    callback new-login();
    callback edit-login(int);
    callback save-login();
    callback ask-delete-login(int);
    callback delete-login(int);
    callback copy-username(int);
    callback copy-password(int);
    callback copy-login-code(int);
    callback open-url(int);
    callback reveal-password(int);
    callback fill-generated();
    callback generator-changed();
    callback copy-generated();
    callback import-csv();

    callback open-export();
    callback toggle-pick(bool, int);
    callback pick-all(bool, bool);
    callback export-qr();
    callback export-backup(string, string);
    callback restore-backup();
    callback restore-password(string);
    callback close-dialog();
    callback pin-entered(string);

    callback open-settings();
    callback settings-changed();
    callback start-with-windows-changed(bool);
    callback change-pin(string, string, string);

    callback open-browser();
    callback browser-toggled(bool);
    callback browser-open-folder();
    callback browser-copy-path();
    callback browser-remove(string);
    callback pair-answer(bool);
    callback access-answer(bool);
}

// ------------------------------------------------------------------ small parts

component Icon inherits Path {
    in property <string> icon;
    in property <length> size: 18px;
    commands: icon;
    viewbox-width: 24;
    viewbox-height: 24;
    width: size;
    height: size;
    fill: Palette.foreground;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> icon-size: 18px;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: !enabled ? transparent : touch.pressed ? Palette.foreground.with-alpha(0.14) : touch.has-hover ? Palette.foreground.with-alpha(0.07) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Icon {
        icon: root.icon;
        size: root.icon-size;
        fill: root.enabled ? Palette.foreground.with-alpha(0.85) : Palette.foreground.with-alpha(0.3);
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Toolbar button: icon above a short label, like KeePassXC.
component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    width: max(58px, label.preferred-width + 16px);
    height: 48px;
    border-radius: 4px;
    background: !enabled ? transparent : touch.pressed ? Palette.foreground.with-alpha(0.14) : touch.has-hover ? Palette.foreground.with-alpha(0.07) : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    VerticalLayout {
        padding-top: 5px;
        padding-bottom: 4px;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Icon {
                icon: root.icon;
                size: 20px;
                fill: root.enabled ? Theme.brand : Palette.foreground.with-alpha(0.3);
            }
        }
        label := Text {
            text: root.text;
            font-size: 11px;
            horizontal-alignment: center;
            color: root.enabled ? Palette.foreground : Palette.foreground.with-alpha(0.35);
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component VSeparator inherits Rectangle {
    width: 1px;
    background: Palette.border;
}

component HSeparator inherits Rectangle {
    height: 1px;
    background: Palette.border;
}

component Hint inherits Text {
    font-size: 12px;
    color: Theme.dim;
    wrap: word-wrap;
}

component ErrorText inherits Text {
    font-size: 12px;
    color: Theme.danger;
    wrap: word-wrap;
}

component InfoText inherits Text {
    font-size: 12px;
    color: Theme.success;
    wrap: word-wrap;
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Palette.foreground;
}

component FieldLabel inherits Text {
    font-size: 12px;
    color: Theme.dim;
    vertical-alignment: center;
}

component LinkText inherits Text {
    callback clicked;
    color: touch.has-hover ? Theme.brand.brighter(0.2) : Theme.brand;
    font-size: 12px;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Coloured circle with the first letter of a name.
component Avatar inherits Rectangle {
    in property <string> letter;
    in property <length> size: 26px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: Theme.brand-soft;
    Text {
        text: root.letter == "" ? "?" : root.letter;
        font-size: root.size * 0.48;
        font-weight: 600;
        color: Theme.brand;
    }
}

// Ring-less countdown: seconds left over a thin bar.
component Countdown inherits VerticalLayout {
    in property <int> remaining;
    in property <float> progress;
    in property <bool> warn;
    alignment: center;
    spacing: 3px;
    Text {
        text: root.remaining + " s";
        font-size: 11px;
        color: root.warn ? Theme.danger : Theme.dim;
        horizontal-alignment: right;
    }
    Rectangle {
        height: 3px;
        border-radius: 1.5px;
        background: Theme.faint;
        Rectangle {
            x: 0;
            width: parent.width * root.progress;
            border-radius: 1.5px;
            background: root.warn ? Theme.danger : Theme.brand;
        }
    }
}

component BrandMark inherits Rectangle {
    in property <length> size: 64px;
    width: size;
    height: size;
    border-radius: size / 4;
    background: #2563eb;
    Path {
        commands: Icons.shield;
        fill: white;
        viewbox-width: 24;
        viewbox-height: 24;
        width: root.size * 0.58;
        height: root.size * 0.58;
    }
}

// ------------------------------------------------------------------ setup / lock

component SetupPage inherits Rectangle {
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 400px;
                spacing: 12px;
                HorizontalLayout { alignment: center; BrandMark { } }
                Text {
                    text: "Welcome to Authenticator";
                    font-size: 22px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
                Hint {
                    text: "Create a PIN or password to protect your 2FA codes and passwords. If you forget it, what is stored on this PC cannot be recovered, so keep a backup.";
                    horizontal-alignment: center;
                }
                Rectangle { height: 6px; }
                pin := LineEdit {
                    input-type: password;
                    placeholder-text: "New PIN or password (at least 4 characters)";
                    accepted => { confirm.focus(); }
                    init => { self.focus(); }
                }
                confirm := LineEdit {
                    input-type: password;
                    placeholder-text: "Repeat PIN or password";
                    accepted => { App.create-pin(pin.text, confirm.text); }
                }
                if App.lock-error != "": ErrorText { text: App.lock-error; horizontal-alignment: center; }
                Button {
                    text: "Create";
                    primary: true;
                    clicked => { App.create-pin(pin.text, confirm.text); }
                }
            }
        }
    }
}

component LockPage inherits Rectangle {
    property <bool> show-reset: false;
    public function focus-pin() { pin.focus(); }
    function submit() {
        App.unlock(pin.text);
        pin.text = "";
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 380px;
                spacing: 12px;
                HorizontalLayout { alignment: center; BrandMark { } }
                Text {
                    text: "Authenticator is locked";
                    font-size: 22px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
                if App.lock-hint != "": Rectangle {
                    border-radius: 6px;
                    background: Theme.brand-soft;
                    height: hint-text.preferred-height + 16px;
                    hint-text := Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: App.lock-hint;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Palette.foreground;
                        horizontal-alignment: center;
                    }
                }
                Hint { text: "Enter your PIN or password."; horizontal-alignment: center; }
                pin := LineEdit {
                    input-type: password;
                    placeholder-text: "PIN or password";
                    accepted => { root.submit(); }
                }
                if App.lock-error != "": ErrorText { text: App.lock-error; horizontal-alignment: center; }
                Button {
                    text: "Unlock";
                    primary: true;
                    clicked => { root.submit(); }
                }
                HorizontalLayout {
                    alignment: center;
                    LinkText {
                        text: root.show-reset ? "Cancel" : "Forgot your PIN?";
                        clicked => { root.show-reset = !root.show-reset; }
                    }
                }
                if root.show-reset: Rectangle {
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.border;
                    height: reset-box.preferred-height;
                    reset-box := VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        ErrorText {
                            text: "Without the PIN nothing can be decrypted. Resetting deletes every 2FA code and password stored on this PC. You can restore them afterwards from a backup file.";
                        }
                        confirm := LineEdit { placeholder-text: "Type DELETE to confirm"; }
                        Button {
                            text: "Delete everything and start over";
                            enabled: confirm.text == "DELETE";
                            clicked => { App.reset-all(confirm.text); }
                        }
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ main window parts

component Toolbar inherits Rectangle {
    in property <bool> has-selection;
    callback search-accepted;
    in property <bool> codes: App.section == Section.codes;
    public function focus-search() { search.focus(); search.select-all(); }
    height: 58px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;
        ToolButton {
            icon: Icons.add;
            text: root.codes ? "Add code" : "Add password";
            clicked => {
                if (root.codes) { App.dialog-error = ""; App.dialog-info = ""; App.dialog = Dialog.add-code; } else { App.new-login(); }
            }
        }
        ToolButton {
            icon: Icons.edit;
            text: "Edit";
            enabled: root.has-selection;
            clicked => {
                if (root.codes) { App.edit-code(App.codes[App.code-index].id); } else { App.edit-login(App.logins[App.login-index].id); }
            }
        }
        ToolButton {
            icon: Icons.delete;
            text: "Delete";
            enabled: root.has-selection;
            clicked => {
                if (root.codes) { App.ask-delete-code(App.codes[App.code-index].id); } else { App.ask-delete-login(App.logins[App.login-index].id); }
            }
        }
        VSeparator { }
        ToolButton {
            icon: Icons.copy;
            text: root.codes ? "Copy code" : "Copy password";
            enabled: root.has-selection;
            clicked => {
                if (root.codes) { App.copy-code(App.codes[App.code-index].id); } else { App.copy-password(App.logins[App.login-index].id); }
            }
        }
        if !root.codes: ToolButton {
            icon: Icons.person;
            text: "Copy user";
            enabled: root.has-selection;
            clicked => { App.copy-username(App.logins[App.login-index].id); }
        }
        if !root.codes: ToolButton {
            icon: Icons.timer;
            text: "Copy 2FA";
            enabled: root.has-selection && App.logins[App.login-index].otp-code != "";
            clicked => { App.copy-login-code(App.logins[App.login-index].id); }
        }
        if root.codes: ToolButton {
            icon: Icons.qr;
            text: "Show QR";
            enabled: root.has-selection;
            clicked => { App.show-code-qr(App.codes[App.code-index].id); }
        }
        VSeparator { }
        ToolButton {
            icon: Icons.export;
            text: "Export";
            clicked => { App.open-export(); }
        }
        ToolButton {
            icon: Icons.lock;
            text: "Lock";
            clicked => { App.lock(); }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            search := LineEdit {
                width: 240px;
                placeholder-text: "Search (Ctrl+F)";
                text <=> App.search;
                edited(text) => { App.search-changed(text); }
                accepted => { root.search-accepted(); }
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) {
                        root.search-accepted();
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        self.text = "";
                        App.search-changed("");
                        return accept;
                    }
                    reject
                }
            }
        }
    }
}

component SidebarItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <int> count;
    in property <bool> selected;
    callback clicked;
    height: 34px;
    border-radius: 4px;
    background: selected ? Theme.brand-soft : touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent;
    accessible-role: tab;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { icon: root.icon; size: 18px; fill: root.selected ? Theme.brand : Palette.foreground.with-alpha(0.7); }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-weight: root.selected ? 600 : 400;
            color: Palette.foreground;
            horizontal-stretch: 1;
        }
        Text {
            text: root.count;
            vertical-alignment: center;
            font-size: 11px;
            color: Theme.dim;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component Sidebar inherits Rectangle {
    width: 190px;
    background: Theme.sidebar;
    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        SidebarItem {
            icon: Icons.timer;
            text: "2FA codes";
            count: App.code-total;
            selected: App.section == Section.codes;
            clicked => { App.section = Section.codes; App.section-changed(); }
        }
        SidebarItem {
            icon: Icons.key;
            text: "Passwords";
            count: App.login-total;
            selected: App.section == Section.passwords;
            clicked => { App.section = Section.passwords; App.section-changed(); }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            padding-left: 6px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Icon { icon: Icons.extension; size: 14px; fill: Theme.dim; }
            }
            LinkText {
                text: App.browser-enabled ? "Browser: on" : "Browser: off";
                vertical-alignment: center;
                clicked => { App.open-browser(); }
            }
        }
    }
}

component HeaderCell inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Theme.dim;
    vertical-alignment: center;
    overflow: elide;
}

component CodeItem inherits Rectangle {
    in property <CodeRow> entry;
    in property <bool> selected;
    callback select;
    callback activate;
    height: 46px;
    background: selected ? Theme.brand-soft : touch.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;
    accessible-role: list-item;
    accessible-label: entry.title + " " + entry.account + ": " + entry.code;
    accessible-action-default => { root.activate(); }

    touch := TouchArea {
        clicked => { root.select(); }
        double-clicked => { root.activate(); }
    }
    ContextMenuArea {
        Menu {
            MenuItem { title: "Copy code"; activated => { App.copy-code(root.entry.id); } }
            if root.entry.hotp: MenuItem { title: "Next code"; activated => { App.next-hotp(root.entry.id); } }
            MenuItem { title: "Show QR code…"; activated => { App.show-code-qr(root.entry.id); } }
            MenuSeparator { }
            MenuItem { title: "Edit…"; activated => { App.edit-code(root.entry.id); } }
            MenuItem { title: "Delete…"; activated => { App.ask-delete-code(root.entry.id); } }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout { alignment: center; Avatar { letter: root.entry.initial; } }
        Text {
            text: root.entry.title;
            font-weight: 600;
            color: Palette.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 3;
            min-width: 60px;
            preferred-width: 100px;
        }
        Text {
            text: root.entry.account;
            color: Theme.dim;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 3;
            min-width: 60px;
            preferred-width: 100px;
        }
        Text {
            width: 120px;
            text: root.entry.code;
            font-size: 19px;
            font-weight: 600;
            letter-spacing: 1px;
            color: root.entry.warn ? Theme.danger : Theme.code;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        if !root.entry.hotp: Countdown {
            width: 56px;
            remaining: root.entry.remaining;
            progress: root.entry.progress;
            warn: root.entry.warn;
        }
        if root.entry.hotp: Rectangle {
            width: 56px;
            IconButton {
                x: parent.width - self.width;
                icon: Icons.refresh;
                label: "Next code";
                clicked => { App.next-hotp(root.entry.id); }
            }
        }
    }
    HSeparator { y: parent.height - 1px; x: 12px; width: parent.width - 24px; background: Theme.faint; }
}

component LoginItem inherits Rectangle {
    in property <LoginRow> entry;
    in property <bool> selected;
    callback select;
    callback activate;
    height: 40px;
    background: selected ? Theme.brand-soft : touch.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;
    accessible-role: list-item;
    accessible-label: entry.title + " " + entry.username;
    accessible-action-default => { root.activate(); }

    touch := TouchArea {
        clicked => { root.select(); }
